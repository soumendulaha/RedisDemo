mvn io.quarkus:quarkus-maven-plugin:3.8.2:create \
  -DprojectGroupId=com.example \
  -DprojectArtifactId=auth-redis-demo \
  -DclassName="com.example.AuthorizationResource" \
  -Dpath="/auth" \
  -Dextensions="resteasy-reactive,redis-client,jackson"


